{
  "name": "pandax",
  "version": "1.0.0",
  "private": true,
  "description": "PandaX Monorepo",
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "scripts": {
    "demo": "npm run demo --workspace @pandax/dashboard",
    "build:dashboard": "npm run build --workspace @pandax/dashboard",
    "typecheck:dashboard": "npm run typecheck --workspace @pandax/dashboard",
    "test:dashboard": "npm run test --workspace @pandax/dashboard",
    "video:capture": "node apps/showcase-video/scripts/capture.mjs",
    "video:voiceover": "uv run --with kokoro-onnx --with soundfile python apps/showcase-video/scripts/generate_voiceover.py",
    "video:render": "remotion render apps/showcase-video/src/index.tsx ActisRealAnalysisDemo workspace/generated/video/actis-real-analysis-demo.mp4 --public-dir=apps/showcase-video/public --codec=h264 --crf=18 --audio-codec=aac --overwrite --browser-executable=\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "video:render:client": "remotion render apps/showcase-video/src/index.tsx ActisClientDemo workspace/generated/video/actis-client-demo.mp4 --public-dir=apps/showcase-video/public --codec=h264 --crf=16 --overwrite --browser-executable=\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "video:render:client:v2": "remotion render apps/showcase-video/src/index.tsx ActisClientDemoV2 workspace/generated/video/actis-client-demo-v2.mp4 --public-dir=apps/showcase-video/public --codec=h264 --crf=16 --overwrite --browser-executable=\"C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe\"",
    "video:studio": "remotion studio apps/showcase-video/src/index.tsx --public-dir=apps/showcase-video/public"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
