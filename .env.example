# Use separate secret-manager values in staging and private beta. Run Alembic
# before starting the API. Managed environments reject SQLite and missing URLs.
PANDAX_ENVIRONMENT=beta
PANDAX_DATABASE_URL=postgresql+psycopg://actis:change-me@localhost:5432/actis
PANDAX_DATABASE_HARD_STOP_MB=250

# Supabase Auth identity validation. The API fails closed when these are absent.
# Disable public/anonymous sign-up, invite users through an admin, and require
# TOTP MFA. Application roles remain in PostgreSQL.
PANDAX_OIDC_ISSUER=https://project-ref.supabase.co/auth/v1
PANDAX_OIDC_AUDIENCE=authenticated
PANDAX_OIDC_JWKS_URI=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Browser origins allowed to call the API. Wildcards and non-local HTTP origins
# are rejected. Leave empty when the dashboard and API share one origin.
PANDAX_CORS_ORIGINS=https://dashboard.actis.example.com

# Local engine artifacts and legacy case/monitor stores.
PANDAX_DATA_DIR=./workspace/data
