# Use separate secret-manager values in staging and private beta. Run Alembic
# before starting the API. Managed environments reject SQLite and missing URLs.
PANDAX_ENVIRONMENT=beta
# Optional outside Render. Render supplies RENDER_GIT_COMMIT and the API derives
# beta-<commit> when no explicit release ID is configured.
PANDAX_RELEASE_ID=
PANDAX_BUILD_TIMESTAMP=
PANDAX_DATABASE_URL=postgresql+psycopg://actis:change-me@localhost:5432/actis
PANDAX_DATABASE_HARD_STOP_MB=250

# Evidence signing. Staging/private beta accept only a PKCS#8 Ed25519 key held
# in the deployment secret manager and decoded in memory; no key file is made.
# Production accepts only google-cloud-kms and an exact CryptoKeyVersion name.
PANDAX_SIGNER_PROVIDER=secret
PANDAX_SIGNING_KEY_B64=replace-with-base64-pkcs8-secret
PANDAX_SIGNING_KEY_ID=beta-release
PANDAX_SIGNING_KEY_VERSION=1
# Optional for beta; mandatory in production. Base64 of an
# actis/signing-key-registry/v1 JSON document containing public keys only.
PANDAX_SIGNING_KEY_REGISTRY_B64=
# Production only:
# PANDAX_GCP_KMS_KEY_VERSION=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY/cryptoKeyVersions/VERSION

# Private Supabase Storage. Use different project URLs and secret keys in
# staging and private beta. The bucket must exist and must not be public.
PANDAX_STORAGE_URL=https://project-ref.supabase.co
PANDAX_STORAGE_SECRET_KEY=sb_secret_change-me
PANDAX_STORAGE_BUCKET=actis-evidence

# Supabase Auth identity validation. The API fails closed when these are absent.
# Disable public/anonymous sign-up, invite users through an admin, and require
# TOTP MFA. Application roles remain in PostgreSQL.
PANDAX_OIDC_ISSUER=https://project-ref.supabase.co/auth/v1
PANDAX_OIDC_AUDIENCE=authenticated
PANDAX_OIDC_JWKS_URI=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Browser origins allowed to call the API. Wildcards and non-local HTTP origins
# are rejected. Leave empty when the dashboard and API share one origin.
PANDAX_CORS_ORIGINS=https://dashboard.actis.example.com

# External notification worker. Provider secrets are injected separately by the
# deployment secret manager and must never be committed here.
PANDAX_NOTIFICATION_DAILY_LIMIT=500
PANDAX_NOTIFICATION_DELIVERY_SECONDS=30

# Shared only by the Render API and the cron-only Cloudflare Worker. Generate
# a separate random value of at least 32 characters for each environment.
PANDAX_SCHEDULER_SECRET=replace-with-random-32-character-secret

# Local engine artifacts and legacy case/monitor stores.
PANDAX_DATA_DIR=./workspace/data
