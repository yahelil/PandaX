# Production portfolio database. Run Alembic before starting the API.
PANDAX_DATABASE_URL=postgresql+psycopg://actis:change-me@localhost:5432/actis

# OIDC access-token validation. The API fails closed when these are absent.
PANDAX_OIDC_ISSUER=https://identity.example.com/
PANDAX_OIDC_AUDIENCE=https://api.actis.example.com
PANDAX_OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json

# Browser origins allowed to call the API. Wildcards and non-local HTTP origins
# are rejected. Leave empty when the dashboard and API share one origin.
PANDAX_CORS_ORIGINS=https://dashboard.actis.example.com

# Local engine artifacts and legacy case/monitor stores.
PANDAX_DATA_DIR=./output/.pandax
