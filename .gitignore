# PandaX POC
.tools/
.cache/
# fetched by tools/bootstrap.py, digest-pinned - not source
fixtures/smarthub-sh100/lib/*.jar
fixtures/*.zip

# Evaluation corpus: real third-party artifacts, re-fetched by tools/evaluate.py
# against pinned digests. Results are reproducible, so neither is committed.
evaluation/corpus/
evaluation/results/

# Presentation artifacts (kept local)
.presentation-build/
presentation-assets/
presentation-output/
*.pptx

# Local neural voice model cache
apps/showcase-video/.models/
