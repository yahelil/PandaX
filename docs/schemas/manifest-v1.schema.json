{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pandax.online/schemas/evidence/manifest-v1.schema.json",
  "title": "Actis evidence manifest v1",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "created",
    "product",
    "tool_versions",
    "ledger_root",
    "ledger_sha256",
    "ledger_records",
    "files"
  ],
  "properties": {
    "schema": { "const": "actis/manifest/v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "format": "date-time" },
    "product": { "type": "object" },
    "tool_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "ledger_root": { "$ref": "#/$defs/sha256" },
    "ledger_sha256": { "$ref": "#/$defs/sha256" },
    "ledger_records": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fileReference" }
    },
    "signature_note": { "type": "string" },
    "signing": {
      "type": "object",
      "required": ["provider", "algorithm", "key_id", "key_version", "public_key_fingerprint"],
      "properties": {
        "provider": { "enum": ["file", "secret", "google-cloud-kms"] },
        "algorithm": { "const": "Ed25519" },
        "key_id": { "type": "string", "minLength": 1 },
        "key_version": { "type": "string", "minLength": 1 },
        "public_key_fingerprint": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileReference": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  }
}
