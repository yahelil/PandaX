  "scenarios": [
    {
      "id": "tomcat-partial-put",
      "name": "Apache Tomcat — file upload / session RCE",
      "before": "tomcat-9.0.98",
      "after": "tomcat-9.0.99",
      "component": "tomcat-catalina",
      "package": "pkg:maven/org.apache.tomcat/tomcat-catalina",
      "cves": ["CVE-2025-24813"],
      "source": "https://tomcat.apache.org/security-9.html#Fixed_in_Apache_Tomcat_9.0.99",
      "patch": "https://github.com/apache/tomcat/commit/eb61aade8f8daccaecabf07d428b877975622f72",
      "note": "Real Java web application server: official binary releases with Catalina, bundled libraries, configuration and example webapps. Compare the affected release with Apache's first patched 9.x release. RCE requires writable Default Servlet, partial PUT, file-backed sessions and a deserialization-capable application library; runtime reachability is unverified."
    },
    {
      "id": "openwrt-libubox",
      "name": "OpenWrt / libubox",
      "before": "openwrt-19.07.0",
      "after": "openwrt-19.07.1",
      "component": "libblobmsg-json",
      "cves": [
        "CVE-2020-7248"
      ],
      "note": "Official x86/64 firmware root filesystem. Trace libubox JSON conversion to installed ubus, rpcd and uhttpd dependencies."
    },
    {
      "id": "curl-socks5",
      "name": "curl / libcurl \u2014 SOCKS5",
      "before": "curl-8.3.0",
      "after": "curl-8.4.0",
      "component": "libcurl",
      "cves": [
        "CVE-2023-38545"
      ],
      "note": "Official source releases, including the curl program. Record SOCKS5 remote DNS, buffer size and rate-limit prerequisites; runtime reachability remains unverified."
    },
    {
      "id": "openwrt-dnsmasq",
      "name": "OpenWrt / dnsmasq \u2014 backported fixes",
      "before": "openwrt-19.07.5",
      "after": "openwrt-19.07.6",
      "component": "dnsmasq",
      "cves": [
        "CVE-2020-25681",
        "CVE-2020-25682",
        "CVE-2020-25683",
        "CVE-2020-25684",
        "CVE-2020-25685",
        "CVE-2020-25686",
        "CVE-2020-25687"
      ],
      "note": "Official firmware with standard dnsmasq. Two applicable CVEs; five DNSSEC-related CVEs excluded by the vendor for this package variant. Compare full package revisions."
    },
    {
      "id": "openssl-heartbleed",
      "name": "OpenSSL s_server / libssl \u2014 Heartbleed",
      "before": "openssl-1.0.1f",
      "after": "openssl-1.0.1g",
      "component": "libssl",
      "cves": [
        "CVE-2014-0160"
